        <ListView 
        x:Name="IngredientList"
        ItemsSource="{Binding Ingredients}" 
        HasUnevenRows="True"
        BackgroundColor="White"
        SeparatorVisibility="Default">
            <ListView.Header>
                <Grid RowDefinitions="260,Auto">

                    <!-- HERO -->
                    <Grid Grid.Row="0" HeightRequest="260">
                        <Image Source="{Binding Photo}" Aspect="AspectFill" />
                        <BoxView VerticalOptions="End"
                     HeightRequest="90"
                     BackgroundColor="#80000000" />

                        <VerticalStackLayout
                VerticalOptions="End"
                Margin="16,0,16,20">
                            <Label Text="{Binding RecipeName}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White" />
                            <Label Text="{Binding UserName}"
                       TextColor="#DDDDDD" />
                            <Label Text="{Binding Stars, Converter={StaticResource StarsToEmojiConverter}}"
                       TextColor="#f4c430"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- STATS -->
                    <VerticalStackLayout Grid.Row="1" Padding="16">
                        <Label Text="Stats" FontSize="18" TextColor="Red" />
                        <Label Text="{Binding Serves}" TextColor="Black"/>
                        <Label Text="{Binding PrepTime}" TextColor="Black"/>
                        <Label Text="{Binding CookTime}" TextColor="Black" />
                        <Label Text="Directions" FontSize="18" TextColor="Red" />
                        <Label Text="{Binding Description}" TextColor="Black"/>
                        <Label Text="{Binding IngredientsCount}" FontSize="18" TextColor="Red" />
                    </VerticalStackLayout>

                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <HorizontalStackLayout Padding="10" Spacing="10">

                                <Image Source="{Binding RecipePhoto}"
                                       WidthRequest="56"
                                       HeightRequest="56"
                                       Aspect="AspectFill" />

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}"
                                   FontSize="16"
                                   TextColor="Black"/>
                                    <Label Text="{Binding store}"
                                   FontSize="14"
                                   TextColor="Gray"/> 
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>

   <!-- </VerticalStackLayout>-->
</ContentPage>