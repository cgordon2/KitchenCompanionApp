    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              Padding="12,0"
               InputTransparent="False"
              HeightRequest="56">

            <!-- Title -->
            <Label Grid.Column="0"
                   Text=""
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="#E57373"
                   VerticalOptions="Center" />

            <!-- Favorite / Tag -->
