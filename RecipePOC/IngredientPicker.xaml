
    <ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:local="clr-namespace:RecipePOC;assembly=RecipePOC"
        x:Class="RecipePOC.IngredientPicker">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:RowColorConverter x:Key="RowColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*"
          BackgroundColor="WhiteSmoke"
          Padding="10">

        <!-- Title -->
        <Label Grid.Row="0"
               Text="Select an Ingredient"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center" 
               TextColor="Black"
               Margin="0,0,0,10"/>

        <!-- List -->
        <ListView x:Name="PopupList"
          ItemSelected="OnItemSelected"
          HasUnevenRows="True"
                  Grid.Row="1"

          SeparatorVisibility="None">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="12"
                      BackgroundColor="{Binding ., Converter={StaticResource RowColorConverter}}">

                            <Label Text="{Binding Name}"
                           FontSize="18"
                           TextColor="Black" />

                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</ContentPage>