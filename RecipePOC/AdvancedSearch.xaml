                        </Grid>-->
                        <!-- ✅ GRID CLOSED HERE -->

                        <!-- ⭐ Rating -->
                        <Label Text="Rating" TextColor="Black"/>

                        <HorizontalStackLayout Spacing="2">
                            <Label x:Name="Star1" Text="★" FontSize="28" TextColor="#C0C0C0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="StarTapped" CommandParameter="1"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label x:Name="Star2" Text="★" FontSize="28" TextColor="#C0C0C0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="StarTapped" CommandParameter="2"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label x:Name="Star3" Text="★" FontSize="28" TextColor="#C0C0C0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="StarTapped" CommandParameter="3"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label x:Name="Star4" Text="★" FontSize="28" TextColor="#C0C0C0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="StarTapped" CommandParameter="4"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label x:Name="Star5" Text="★" FontSize="28" TextColor="#C0C0C0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="StarTapped" CommandParameter="5"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        <Label Text="Your recipes only?" TextColor="Black"></Label>
                        <Switch IsToggled="{Binding SearchOnlyUser}"/>
                        <Button Text="Search" Clicked="AdvancedSearchRecipes"/>

                    </VerticalStackLayout>
                </Grid>

            </ScrollView>
        </Grid>
