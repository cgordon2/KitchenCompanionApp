<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipePOC.Pantry"
             Title="Pantry"
             Shell.BackgroundColor="#F9EDEC"    
             Shell.TitleColor="#000000" 
             Shell.ForegroundColor="#000000"
             BackgroundColor="WhiteSmoke">
    <Shell.TitleView
    Shell.BackButtonBehavior="{x:Static Shell.BackButtonBehavior.Default}">
        <Grid  ColumnDefinitions="*,Auto,Auto,Auto,Auto"
      Padding="12,0"
      HeightRequest="56">
            <Label Text=""
               FontSize="25"
               FontFamily="OpenSansRegular"
               TextColor="#E57373"
               FontAttributes="Bold"
               VerticalOptions="Center" />
            <Grid Grid.Column="1"
              HorizontalOptions="End"
              VerticalOptions="Center"
              Margin="0,0,8,6">
                <Label Text="🍅"
                   FontSize="22"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPickerTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid> 
        </Grid>
    </Shell.TitleView>
    <AbsoluteLayout>
        <Grid AbsoluteLayout.LayoutFlags="All"
          AbsoluteLayout.LayoutBounds="0,0,1,1">
            <Grid BackgroundColor="WhiteSmoke"
      RowDefinitions="Auto,*,Auto"
      ColumnDefinitions="*">
                <Grid Grid.Row="0"
      Grid.RowSpan="2"
      RowDefinitions="Auto,Auto,*"
      Padding="5"
      RowSpacing="6"> 
                    <Grid Grid.Row="1"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="10"
          Margin="10,5"> 
                        <Entry Placeholder="Quantity" 
               WidthRequest="140"
                               
               Grid.Column="0"/>

                        <!-- Middle textbox -->
                        <Entry Grid.Column="1"
                               IsEnabled="False"
               Placeholder="Selected Ingredient..."
               x:Name="SelectedIngredientEntry"
               />

                        <!-- Right button -->
                        <Button Text="Save"
                Grid.Column="2"
                WidthRequest="80"/>
                    </Grid>

                    <!-- List -->
                    <ListView x:Name="PantryList"
              Grid.Row="2"
              Margin="10"
              ItemsSource="{Binding Pantrys}"
              HasUnevenRows="True"
              SelectionMode="Single"
              SeparatorVisibility="None"
              BackgroundColor="WhiteSmoke"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Border BackgroundColor="#FFF9F9"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 5"
                            Padding="0"
                            Margin="0">
                                        <Grid ColumnDefinitions="*">
                                            <VerticalStackLayout Padding="10" Spacing="4">

                                                <Label Text="{Binding IngredientName}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#222"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Quantity}"
                                           FontSize="14"
                                           TextColor="#888" />
                                                    <Label Text="{Binding Unit}"
                                           FontSize="14"
                                           TextColor="#888" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="4">
                                                    <Entry Placeholder="Quantity"
                                           WidthRequest="100"
                                           HorizontalOptions="Start"
                                           Text="{Binding EditedQuantity}" />
                                                    <Button Text="Update"
                                            Clicked="OnUpdateClicked" />
                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
